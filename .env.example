# Copia este archivo como .env y completa con tus propios valores.
# .env NUNCA debe commitearse al repositorio (ya está en .gitignore).

# API key personal de NewsAPI
# 1. Ve a https://newsapi.org/register
# 2. Crea una cuenta gratuita con tu correo
# 3. Confirma el correo y copia tu API key del panel
# 4. Reemplaza el valor de abajo
NEWS_API_KEY=YOUR_NEWSAPI_KEY_HERE

# Puerto del servidor Express (opcional, default 3000)
PORT=3000